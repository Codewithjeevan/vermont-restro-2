# AI Insight secrets. Copy this file to application/.env (same folder) and fill it in.
# application/.env is git-ignored and blocked from the web; never commit it.
# A real environment variable with the same name wins over this file.

# Anthropic API key (Console > API keys). Use a separate key for production.
ANTHROPIC_API_KEY=

# Optional: lets a web cron call Ai_cron/web/<token> when the host has no CLI cron.
# Leave empty to keep the web trigger off. At least 32 random characters.
AI_CRON_WEB_TOKEN=

# Optional: 1 = never call the API, return canned replies (tests, no tokens used).
AI_MOCK=0
